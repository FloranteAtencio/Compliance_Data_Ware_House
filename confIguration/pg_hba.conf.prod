# TYPE  DATABASE        USER            ADDRESS                 METHOD
local   replication     erp_admin                               trust
local   all             all                                     trust
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256
host    erp_db          erp_admin       203.0.113.50/32         scram-sha-256
host    replication     replication     192.168.1.100/32        scram-sha-256
host    all             all             0.0.0.0/0               scram-sha-256
# pg_hba.conf example
local   all             etl_user        peer                    # local socket, no TLS needed
hostssl all             remote_staff    0.0.0.0/0               scram-sha-256  # network = TLS required